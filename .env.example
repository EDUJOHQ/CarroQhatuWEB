# Configuración del servidor Flask
FLASK_SECRET_KEY=
PORT=

# Base de Datos Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Proveedor de Inteligencia Artificial (Gemini y/o OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Credenciales de Administración del Panel
ADMIN_USERNAME=
ADMIN_PASSWORD=

# SEGURIDAD AVANZADA (OPCIONAL EN DESARROLLO, RECOMENDADO EN PRODUCCIÓN)
# Ruta secreta para el panel de login (ej: carroqhatu_admin_secret_2026). Ruta resultante: /admin/login-<SLUG>
ADMIN_SECRET_SLUG=
# PIN de Doble Factor (2FA) estático (ej: 839201). Deja vacío para desactivar.
ADMIN_2FA_PIN=
# Hash de contraseña de administrador (generado con werkzeug.security.generate_password_hash).
# Si se provee, tiene prioridad sobre ADMIN_PASSWORD para máxima seguridad.
ADMIN_PASSWORD_HASH=

# Configuración del Webhook de WhatsApp (Meta Cloud API / Twilio)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# CONFIGURACIÓN EVOLUTION API (CONEXIÓN QR WHATSAPP WEB)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=carroqhatu

